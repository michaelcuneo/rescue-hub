{
  "name": "rescue-hub",
  "version": "1.0.0",
  "private": true,
  "description": "NATF Rescue Hub",
  "license": "ISC",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "sst dev",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:pc": "npm run dev --workspace=website",
    "sst:install": "sst install",
    "deploy": "sst deploy",
    "deploy:production": "sst deploy --stage production",
    "remove": "sst remove",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "sst": "^4.17.1",
    "typescript": "^6.0.3"
  }
}
