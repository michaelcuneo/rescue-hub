{
  "expo": {
    "name": "Rescue Hub",
    "slug": "rescue-hub",
    "scheme": "rescuehub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.michaelcuneo.rescuehub"
    },
    "android": {
      "package": "au.com.michaelcuneo.rescuehub"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rescue Hub uses your location while the app is open to centre the map and help you mark injured wildlife accurately.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
